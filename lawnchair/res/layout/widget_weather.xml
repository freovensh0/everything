<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/weather_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto"
        android:includeFontPadding="false"
        android:textColor="@color/widget_card_text"
        android:textSize="46sp" />

    <ImageView
        android:id="@+id/weather_glyph"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/widget_weather_label" />

    <TextView
        android:id="@+id/weather_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_card_text"
        android:textSize="13sp" />

</LinearLayout>
